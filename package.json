{
  "name": "tu-tien-game",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "client", "server"],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "wrangler dev",
    "build": "npm run build -w client",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client",
    "test": "vitest run",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "deploy:preview": "npm run build && wrangler deploy --env preview",
    "smoke": "node tools/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
