{
  "name": "tu-tien-game",
  "main": "server/src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "MAP_ROOM", "class_name": "MapRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MapRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tu-tien-db",
      // Replace with the real id from `wrangler d1 create tu-tien-db` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "server/migrations"
    }
  ]
}
