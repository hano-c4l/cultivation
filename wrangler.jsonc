{
  "name": "cultivation",
  "main": "server/src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "MAP_ROOM", "class_name": "MapRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MapRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cultivation-db",
      "database_id": "eaee542b-3e9c-4a20-98d6-4554f9953292",
      "migrations_dir": "server/migrations"
    }
  ]
}
